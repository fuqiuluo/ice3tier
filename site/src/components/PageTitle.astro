---
import type { StarlightRouteData } from '@astrojs/starlight/route-data'
import { withBase } from '../lib/base'

// 页面标题，上面一行面包屑：文档 › 所在的分组 › 这一页。首页自己就是“文档”，不要面包屑。
type Entry = StarlightRouteData['sidebar'][number]

function groupOf(entries: Entry[], parent?: string): string | undefined {
  for (const entry of entries) {
    if (entry.type === 'link' && entry.isCurrent) return parent
    if (entry.type === 'group') {
      const found = groupOf(entry.entries, entry.label)
      if (found) return found
    }
  }
  return undefined
}

const { entry, sidebar, lang } = Astro.locals.starlightRoute
const group = groupOf(sidebar)
const home = lang === 'en' ? { label: 'Docs', href: withBase('/en/') } : { label: '文档', href: withBase('/') }
---

{
  group && (
    <nav class="crumbs" aria-label={home.label}>
      <a href={home.href}>{home.label}</a>
      <span aria-hidden="true">›</span>
      <span>{group}</span>
      <span aria-hidden="true">›</span>
      <span class="here">{entry.data.title}</span>
    </nav>
  )
}
<h1 id="_top">{entry.data.title}</h1>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    color: var(--doc-meta);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--doc-heading);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .crumbs [aria-hidden] {
    color: var(--doc-faint);
  }

  .here {
    color: var(--doc-heading);
    font-weight: 500;
  }

  h1 {
    margin-top: 0.375rem;
    color: var(--doc-heading);
    font-size: var(--sl-text-h1);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
</style>
