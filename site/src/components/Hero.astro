---
import { withBase } from '../lib/base'

// 只有 404 页用到它（那一页是 Starlight 的 hero 版式）：标题、一句话、回去的链接。
const { entry } = Astro.locals.starlightRoute
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero ?? {}
---

<div class="hero">
  <h1 id="_top" data-page-title>{title}</h1>
  {tagline && <p>{tagline}</p>}
  {
    actions.length > 0 && (
      <div class="actions">
        {actions.map(({ link, text }) => (
          <a href={withBase(link)}>{text}</a>
        ))}
      </div>
    )
  }
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-block: 6rem;
    text-align: center;
  }

  h1 {
    color: var(--doc-heading);
    font-size: 3rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  p {
    color: var(--doc-muted);
    font-size: 1rem;
  }

  .actions {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.75rem;
  }

  a {
    color: var(--doc-link);
    text-decoration: underline;
    text-decoration-color: var(--doc-link-line);
    text-underline-offset: 0.1875em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }
</style>
